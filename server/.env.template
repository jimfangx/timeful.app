# Google oauth 
# - Create a Google Cloud project, create credentials for a "web application", and put the client id and secret here
# - Your project should have the following scopes: 
#     "./auth/calendar.events.readonly"
#     "./auth/calendar.calendarlist.readonly"
#     "./auth/contacts.readonly"
#     "./auth/directory.readonly"
CLIENT_ID=?
CLIENT_SECRET=?
ANDROID_CLIENT_ID=? # unused
IOS_CLIENT_ID=? # unused

# GCloud
# - Create a service account in Google Cloud with Cloud Task permissions and put the key file here
SERVICE_ACCOUNT_KEY_PATH=? # optional

# Discord bot 
DISCORD_BOT_TOKEN=? # unused
GUILD_ID=? # unused

# Slack bot
SLACK_DEV_WEBHOOK_URL=? # optional
SLACK_PROD_WEBHOOK_URL=? # optional

# Mailchimp
MAILCHIMP_API_KEY=? # unused

# Mailjet
MAILJET_API_KEY=? # unused
MAILJET_API_SECRET=? # unused
MAILJET_LIST_ID=? # unused

# Listmonk
# - Only used for marketing-list bookkeeping (AddUserToListmonk/DoesUserExist)
# - Transactional email (OTP, invites, notifications) is sent via Mailgun below
LISTMONK_URL=? # optional
LISTMONK_USERNAME=? # optional
LISTMONK_PASSWORD=? # optional
LISTMONK_LIST_ID=? # optional

# Mailgun
# - Create a Mailgun account, verify a sending domain, and put its API key and
#   domain here. Used for all transactional email (OTP sign-in code, group
#   invites, response notifications).
MAILGUN_API_KEY=? # required for transactional email
MAILGUN_DOMAIN=? # required for transactional email
# - Mailgun's API (api.mailgun.net) has no IPv6 address. If this server has no
#   outbound IPv4 connectivity, set these to route through a relay instead -
#   see server/services/mailgun/relay-worker/README.md. Leave both unset to
#   send directly to Mailgun (the default).
MAILGUN_API_BASE_URL=? # optional - e.g. https://mailgun-relay.<you>.workers.dev
MAILGUN_RELAY_SECRET=? # optional - required if MAILGUN_API_BASE_URL is set

# Gmail
GMAIL_APP_PASSWORD=? # unused
SCHEJ_EMAIL_ADDRESS=? # unused

# Encryption
ENCRYPTION_KEY=? # Used to encrypt and decrypt sensitive data

# Session
# - Generate a random 32+ character string for session cookie encryption
# - Example generation: openssl rand -base64 32
SESSION_SECRET=?

# CORS
# - Comma-separated list of allowed origins
# - For local development, set to: http://localhost:8080
CORS_ORIGINS=?

# Auth allowlist (optional)
# - If both are empty, sign-in is unrestricted.
# - ALLOWED_EMAILS: exact email allowlist.
# - ALLOWED_EMAIL_DOMAINS: domain allowlist (e.g. berkeley.edu).
ALLOWED_EMAILS=? # optional
ALLOWED_EMAIL_DOMAINS=? # optional